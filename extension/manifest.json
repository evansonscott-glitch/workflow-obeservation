{
  "manifest_version": 3,
  "name": "Workflow Observer",
  "version": "0.1.0",
  "description": "Streams active-tab events to the local Workflow Observer daemon.",
  "permissions": ["tabs", "activeTab", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Workflow Observer"
  }
}
